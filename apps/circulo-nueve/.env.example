# Circulo Nueve — variables de entorno.
# Copia este archivo a `.env.local` y rellena los valores en tu máquina.
# Nunca subas `.env.local` ni pegues valores reales en chats o documentos.
# Sin las variables de Supabase la app funciona en modo demo (sin cuentas).
# En local, los valores salen de `npx supabase status -o env` (API_URL, ANON_KEY,
# SERVICE_ROLE_KEY): son claves de demostración que solo sirven en tu máquina.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Origen público de la app (enlaces de correo y redirecciones). Local: http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=

# --- Alta inicial de la administración ---
# Hash argon2id de la clave de alta, generado con `npm run setup:hash`.
# La clave en texto plano nunca va aquí. Para rotarla antes del alta, genera otro hash.
ADMIN_SETUP_KEY_HASH=

# --- Proveedores LLM ---
# La administración los configura en /admin/proveedores (se guardan en Supabase).
# Cada proveedor indica el NOMBRE de su secreto, que debe empezar con LLM_KEY_;
# el valor se carga aquí (o en Vercel > Settings > Environment Variables). Solo servidor.
LLM_KEY_OPENROUTER=
LLM_KEY_FREELLMAPI=
# Respaldo sin base de datos (desarrollo o demo): un solo proveedor por variables.
# Valores: demo | openrouter | freellmapi | ollama | openai_compatible
LLM_PROVIDER=demo
LLM_BASE_URL=
# Si se omite, OpenRouter usa nvidia/nemotron-3-super-120b-a12b:free (solo demo).
LLM_MODEL=
LLM_MODELOS_ALTERNOS=
# Solo servidor. Llave del proveedor de respaldo.
LLM_API_KEY=
# Solo "true" si la política de datos del endpoint permite datos reales. Se ignora con modelos gratuitos y FreeLLMAPI.
LLM_PERMITE_DATOS_REALES=false
# Tope de gasto mensual del proveedor de respaldo (0 bloquea modelos de pago).
LLM_LIMITE_MENSUAL_USD=0

# --- Voz ---
# browser = síntesis de voz del navegador (gratuita)
TTS_PROVIDER=browser
